{
  "manifest_version": 3,
  "name": "Markdown Sticky Notes — Tab Links",
  "version": "0.4.1",
  "description": "Return to an existing Chrome tab from your local sticky note.",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "storage",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "このウィンドウを付箋に接続"
  },
  "icons": {
    "32": "icons/32.png",
    "128": "icons/128.png",
    "48": "icons/48.png",
    "16": "icons/16.png"
  },
  "key": ""
}